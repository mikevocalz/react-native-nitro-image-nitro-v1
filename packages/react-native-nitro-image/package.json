{
  "name": "react-native-nitro-image",
  "version": "0.15.2-nitro-v1.0",
  "description": "A superfast in-memory Image type and view component for React Native, built with Nitro!",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "lib/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "react-native.config.js",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "apple/**/*.h",
    "apple/**/*.m",
    "apple/**/*.mm",
    "apple/**/*.cpp",
    "apple/**/*.swift",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "Package.swift",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf tsconfig.tsbuildinfo && rm -rf lib && bun typecheck && bob build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "release": "release-it",
    "typescript": "tsc --noEmit false --declaration",
    "specs": "nitrogen --logLevel=\"debug\" && tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrousavy/react-native-nitro-image.git",
    "directory": "packages/react-native-nitro-image"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mrousavy/react-native-nitro-image/issues"
  },
  "homepage": "https://github.com/mrousavy/react-native-nitro-image#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "nitrogen": "1.0.0-alpha.nightly.100.g107f6fc66597",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.100.g107f6fc66597",
    "typescript": "7.0.2",
    "nitro-core": "1.0.0-alpha.nightly.100.g107f6fc66597"
  },
  "peerDependencies": {
    "nitro-core": "*",
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "*"
  },
  "peerDependenciesMeta": {
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": false,
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": "bun typecheck",
      "after:bump": "bun run build"
    }
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "swiftpmConfig": {
    "name": "NitroImage",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  }
}
